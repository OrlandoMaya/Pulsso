# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/pulsso?retryWrites=true&w=majority

# Secreto para firmar los JWT (usa uno largo y aleatorio: `openssl rand -base64 48`)
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=7d

PORT=4000
# Origen del frontend (separa varios con comas)
CORS_ORIGIN=http://localhost:4040

# URL del frontend para los enlaces de "recuperar contraseña" (por defecto, el primer CORS_ORIGIN)
# APP_URL=https://calendar.pulsso.online

# ── Correo saliente (recuperar contraseña) ──
# Sin SMTP_HOST no se envía nada: el enlace solo se escribe en el log de la API.
#
# Con Gmail:
#   1. Activa la verificación en 2 pasos: https://myaccount.google.com/security
#   2. Crea una contraseña de aplicación: https://myaccount.google.com/apppasswords
#      (16 letras; ponlas sin espacios en SMTP_PASS. Tu contraseña normal NO sirve)
#   3. SMTP_FROM debe ser el mismo correo de SMTP_USER
#   4. Tras cambiar este archivo: docker compose up -d --build backend
#      (restart no relee el .env) y revisa: docker compose logs backend | grep -i smtp
#      Si sale timeout, el servidor bloquea el 587: prueba SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_FROM=Pulsso <tu-correo@gmail.com>

# Solo si la API está detrás de un proxy (docker-compose ya lo pone en 1)
# TRUST_PROXY=1
