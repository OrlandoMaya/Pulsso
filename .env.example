# Variables de docker compose (cópialo a .env en la raíz, junto a docker-compose.yml)

# Dominios; los dos deben apuntar (registro A) a la IP del servidor
WEB_DOMAIN=calendar.pulsso.online
API_DOMAIN=calendar-api.pulsso.online

# ── Opción A: Caddy pone HTTPS (los puertos 80 y 443 deben estar libres) ──
COMPOSE_PROFILES=caddy
# Correo para Let's Encrypt (avisos de vencimiento de certificados)
ACME_EMAIL=tu-correo@ejemplo.com
# Si el servidor tiene varias IP y otro proyecto usa el 80 en otra: la IP de Pulsso
# BIND_IP=207.180.216.89

# ── Opción B: ya hay un nginx en el 80 ──
# Borra la línea COMPOSE_PROFILES=caddy y usa deploy/nginx-pulsso.conf en ese nginx.

# ── Opción C: ya hay un Caddy en otro proyecto con el 80/443 ──
# Borra COMPOSE_PROFILES=caddy, descomenta estas dos líneas y pega deploy/edge-caddy.caddy en ese Caddy.
# COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# EDGE_NETWORK=nombre-de-la-red-del-caddy
