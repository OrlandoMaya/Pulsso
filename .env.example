# Variables de docker compose (cópialo a .env en la raíz, junto a docker-compose.yml)

# Dominios; los dos deben apuntar (registro A) a la IP del servidor
WEB_DOMAIN=calendar.pulsso.online
API_DOMAIN=calendar-api.pulsso.online

# Correo para Let's Encrypt (avisos de vencimiento de certificados)
ACME_EMAIL=tu-correo@ejemplo.com
